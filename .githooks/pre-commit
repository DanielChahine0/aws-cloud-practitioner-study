#!/bin/sh
# Runs the fast gate before every commit (spec 1.3); enabled once per clone with: git config core.hooksPath .githooks
# It checks exactly the snapshot being committed, in a throwaway worktree, so unstaged edits and untracked files here,
# such as another agent's work in progress, can neither hide a failure nor cause one.
set -eu

staged=$(git write-tree)
root=$(git rev-parse --show-toplevel)
# Git points these at this checkout's index for the hook; the worktree and the checks must not inherit them.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_PREFIX

tree=$(mktemp -d "${TMPDIR:-/tmp}/ccp-pre-commit.XXXXXX")
cleanup() {
  rm -f "$tree/node_modules"
  git -C "$root" worktree remove --force "$tree" 2>/dev/null || rm -rf "$tree"
  git -C "$root" worktree prune
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

git -C "$root" worktree add --quiet --detach --no-checkout "$tree" HEAD
git -C "$tree" read-tree --reset -u "$staged"
# The checks use this checkout's dependencies through a link, so pnpm must not try to install into the worktree.
ln -s "$root/node_modules" "$tree/node_modules"
cd "$tree"

# Git can run this hook from a shell where fnm never switched Node, so switch here to the version the snapshot pins.
pinned=v$(sed 's/^v//' .node-version | tr -d '[:space:]')
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)"
  fnm use --silent-if-unchanged >/dev/null 2>&1 || true
fi
active=$(node --version 2>/dev/null || echo none)
if [ "$active" != "$pinned" ]; then
  echo "pre-commit: Node $active is active but .node-version pins $pinned; install it with 'fnm install' or switch to it, then commit again." >&2
  exit 1
fi

pnpm_config_verify_deps_before_run=false pnpm check
