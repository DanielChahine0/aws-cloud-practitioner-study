{
  "name": "ccp-study",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budgets.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "content:validate": "node scripts/content/validate.ts",
    "content:fingerprint": "node scripts/content/fingerprint.ts",
    "content:concepts": "node scripts/content/concepts.ts",
    "content:new-question": "node scripts/content/new-question.ts",
    "content:checks": "node scripts/content/checks.ts",
    "content:stamp": "node scripts/content/stamp.ts",
    "content:quotas": "node scripts/content/quotas.ts",
    "content:forms": "node scripts/content/forms.ts",
    "content:report": "node scripts/content/report.ts",
    "content:updates": "node scripts/content/updates.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm content:validate && pnpm test",
    "e2e": "playwright test",
    "verify": "pnpm check && pnpm build && pnpm e2e",
    "site:deploy": "node scripts/site-deploy.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "10.29.8",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.1",
    "fast-check": "4.10.2",
    "marked": "18.0.14",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
